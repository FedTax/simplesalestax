{
  "name": "simplesalestax",
  "version": "8.3.1",
  "description": "A TaxCloud integration for WooCommerce.",
  "scripts": {
    "build": "npm run build:blocks && npm run build:makepot && grunt",
    "build:blocks": "wp-scripts build assets/js/blocks/tax-exemption/",
    "build:makepot": "wp i18n make-pot . languages/simple-sales-tax.pot --domain=simple-sales-tax",
    "dev": "npm run dev:blocks",
    "dev:blocks": "wp-scripts start assets/js/blocks/tax-exemption/",
    "format": "wp-scripts format",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "lint:md:docs": "markdownlint --fix docs/**/*.md",
    "lint:php": "composer run-script phpcs",
    "packages-update": "wp-scripts packages-update",
    "plugin-zip": "grunt",
    "test:e2e": "start-server-and-test 'npm run wp-env start' http://localhost:8888 'cypress run'",
    "test:e2e:dev": "start-server-and-test 'npm run wp-env start' http://localhost:8888 'cypress open'",
    "wp-env": "wp-env"
  },
  "devDependencies": {
    "@wordpress/scripts": "^26.19.0",
    "cypress": "^13.6.4",
    "grunt": "^1.6.1",
    "grunt-contrib-clean": "^2.0.1",
    "grunt-contrib-compress": "^2.0.0",
    "grunt-contrib-copy": "^1.0.0",
    "grunt-contrib-watch": "^1.1.0",
    "grunt-wp-deploy": "^2.1.2",
    "markdownlint-cli": "^0.35.0",
    "start-server-and-test": "^2.0.3",
    "wp-env": "^9.4.0"
  },
  "dependencies": {
    "@testing-library/cypress": "^10.0.1",
    "@woocommerce/woocommerce-rest-api": "^1.0.1"
  }
}
